# Editor settings for IntelliJ, VS Code, and other editors. Keep these values the same as in .prettierrc.json.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.md]
max_line_length = 120
# Two spaces at the end of a line make a line break in Markdown.
trim_trailing_whitespace = false

[*.{kt,kts}]
indent_size = 4
