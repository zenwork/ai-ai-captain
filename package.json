{
  "name": "ai-ai-captain",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.json && tsc -p streamdeck/tsconfig.json && npm run build:streamdeck",
    "build:web": "esbuild web-src/main.ts --bundle --format=esm --outfile=web/app.js && esbuild web-src/deck.ts --bundle --format=esm --outfile=web/deck.js",
    "build:streamdeck": "npm run build:web && esbuild streamdeck/src/plugin.ts --bundle --platform=node --format=cjs --target=node20 --outfile=streamdeck/com.local.ai-ai-captain.sdPlugin/bin/plugin.cjs && esbuild src/server/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=streamdeck/com.local.ai-ai-captain.sdPlugin/bin/hub.cjs && node scripts/package-streamdeck.mjs",
    "design:preview": "node scripts/render-design-proposals.mjs --write --png",
    "design:check": "node scripts/render-design-proposals.mjs --check",
    "design:mockup": "tsx scripts/render-deck-mockup.ts",
    "demo:keys": "tsx scripts/demo-keys.ts",
    "deck:app": "sh scripts/deck-app.sh",
    "reload:streamdeck": "npm run build:streamdeck && node scripts/streamdeck-cli.mjs",
    "build:sea": "npm run build && node scripts/build-sea.mjs",
    "start": "node dist/server/main.js",
    "report": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p streamdeck/tsconfig.json"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@elgato/streamdeck": "^3.0.3",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@elgato/utils": {
      "zod": "^4.6.7"
    }
  }
}
